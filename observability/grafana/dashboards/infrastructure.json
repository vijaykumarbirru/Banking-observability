    {
      "type": "stat",
      "title": "Targets up",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min by (job) (up{job!=\"bank-services\"}) or label_replace(min(up{job=\"bank-services\"}), \"job\", \"blackbox-exporter\", \"\", \"\")",
          "legendFormat": "{{job}}",
          "instant": true,
          "range": false,
          "format": "time_series",
          "exemplar": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "#E5484D"
                },
                "1": {
                  "text": "UP",
                  "color": "#22A55B"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#E5484D",
                "value": null
              },
              {
                "color": "#22A55B",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "background",
        "textMode": "value_and_name",
        "graphMode": "none",
        "orientation": "vertical"
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 4
