    {
      "type": "stat",
      "title": "Success rate",
      "description": "Completed / (completed + failed + blocked).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pg-transfer"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg-transfer"
          },
          "rawSql": "SELECT 100.0 * count(*) FILTER (WHERE status = 'COMPLETED')\n                 / NULLIF(count(*) FILTER (WHERE status IN ('COMPLETED','FAILED','BLOCKED')), 0)\n               FROM transfers WHERE $__timeFilter(created_at)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
