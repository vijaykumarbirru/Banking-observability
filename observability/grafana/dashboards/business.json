      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg-transfer"
          },
          "rawSql": "SELECT $__timeGroupAlias(created_at, '1h', 0), mode AS metric, count(*) AS value\n               FROM transfers WHERE status IN ('COMPLETED','PROCESSING') AND $__timeFilter(created_at) GROUP BY 1, 2 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
