    {
      "type": "table",
      "title": "Latest transfers",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pg-transfer"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg-transfer"
          },
          "rawSql": "SELECT created_at AS \"Time\", reference AS \"Reference\", mode AS \"Mode\",\n               beneficiary_name AS \"Beneficiary\", amount_paise/100.0 AS \"Amount\", status AS \"Status\", failure_reason AS \"Reason\"\n               FROM transfers WHERE status <> 'OTP_REQUIRED' ORDER BY created_at DESC LIMIT 15",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Amount"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyINR"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "COMPLETED": {
                        "color": "#22A55B"
                      },
                      "PROCESSING": {
                        "color": "#F59F00"
                      },
                      "FAILED": {
                        "color": "#E5484D"
                      },
                      "BLOCKED": {
                        "color": "#E5484D"
                      }
                    }
                  }
                ]
              }
            ]
